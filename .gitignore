# --- credentials (never commit) ---
# Broad patterns on purpose: an exact-name rule missed `.hf_token.txt.txt`
# (a Notepad "save as" artifact), which `git add -A` then staged. The push was
# rejected before it reached the remote, but the near miss is why these are
# now wildcards rather than one literal filename.
hf_token.txt
*hf_token*
*.token
*token.txt
.env
secrets.*

# --- environments & caches ---
.venv/
__pycache__/
*.pyc
.claude/
webapp/frontend/node_modules/
webapp/frontend/dist/

# --- recordings & processed results (private audio stays local) ---
recording/
outputs/
outputs_v2/
uploads/
checkpoints/
*.wav
*.mp3
*.mp4
*.m4a
*.flac

# --- decks & internal docs ---
*.pptx
append_usecase2.py
image.png

# --- logs & leftovers ---
*.log
setup_log.txt
*.whl
server.log

# --- test/tooling caches & local stores ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
test_input/
store/
